# copy this to .env.local (git ignores it) & fill in what you need

# DATA_SOURCE=demo runs the whole app on in-memory sample data, so no database is needed
DATA_SOURCE=demo

# for real data, remove DATA_SOURCE & point at Postgres (Neon)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# until sign-in exists, local development borrows this user (an id from the users table).
# It's refused in production, so an unauthenticated deploy can't expose a real logbook.
# DEV_USER_ID=

# coming with later milestones
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# AUTH_ALLOWED_USER_IDS=
# OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
